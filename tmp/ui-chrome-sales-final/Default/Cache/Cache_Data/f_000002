/*
 * AAFIA Enterprise design system.
 * This is intentionally self-contained: the packaged app and the development
 * server load the same static file, with system font fallbacks for offline use.
 */
:root {
    --font-sans: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    --ink-strong: #172033; --ink: #344054; --ink-muted: #667085;
    --surface: #fff; --surface-subtle: #f8fafc; --surface-muted: #f1f5f9;
    --canvas: #f5f7fb; --line: #e2e8f0; --line-strong: #cbd5e1;
    --primary: #1d4ed8; --primary-hover: #1e40af; --primary-soft: #e8efff;
    --navy: #172554; --navy-deep: #0f1b3d;
    --success: #15803d; --success-soft: #ecfdf3;
    --warning: #a15c07; --warning-soft: #fffaeb;
    --danger: #b42318; --danger-soft: #fff1f1;
    --shadow-sm: 0 1px 2px rgba(15, 23, 42, .04);
    --shadow-md: 0 8px 24px rgba(15, 23, 42, .08);
    --radius-sm: 6px; --radius: 10px; --radius-lg: 14px;
    --focus-ring: 0 0 0 3px rgba(37, 99, 235, .18);
}
* { box-sizing: border-box; }
html { min-width: 320px; }
body { min-width: 320px; margin: 0; overflow-x: hidden; background: var(--canvas); color: var(--ink); font-family: var(--font-sans); font-size: 14px; line-height: 1.5; }
a { color: inherit; text-decoration: none; }
button, input, select, textarea { font: inherit; }
button, select { cursor: pointer; }
button:disabled, input:disabled, select:disabled, textarea:disabled { cursor: not-allowed; opacity: .56; }
:focus-visible { outline: 3px solid rgba(37, 99, 235, .25); outline-offset: 2px; }
::selection { background: #c7d7fe; color: var(--ink-strong); }

/* Landing */
.landing-page { position: relative; min-height: 100vh; overflow: hidden; color: #f8fbff; background: radial-gradient(circle at 12% 4%, rgba(96,165,250,.28), transparent 28rem), radial-gradient(circle at 90% 90%, rgba(45,212,191,.18), transparent 30rem), linear-gradient(145deg, #10214d 0%, #173c79 47%, #0f2452 100%); }
.hero-atmosphere { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
.glow { position: absolute; border-radius: 999px; filter: blur(16px); }
.glow-primary { top: -18vw; left: -14vw; width: 44vw; height: 44vw; background: rgba(96,165,250,.24); }
.glow-secondary { right: -13vw; bottom: -22vw; width: 56vw; height: 56vw; background: rgba(45,212,191,.17); }
.grid-horizon { position: absolute; bottom: -22%; left: -8%; width: 116%; height: 55%; opacity: .34; transform: perspective(440px) rotateX(58deg) rotateZ(-7deg); background-image: linear-gradient(rgba(191,219,254,.2) 1px, transparent 1px), linear-gradient(90deg,rgba(191,219,254,.2) 1px, transparent 1px); background-size: 48px 48px; }
.orb { position: absolute; border: 1px solid rgba(219,234,254,.45); border-radius: 50%; }
.orb-large { top: 10%; right: -7vw; width: 22vw; height: 22vw; }
.orb-small { top: 27%; left: 22%; width: 9px; height: 9px; }
.topbar { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; padding: 28px 6vw; }
.brand-mark { display: block; line-height: 0; }
.brand-mark img { display: block; width: auto; max-width: 190px; height: auto; max-height: 48px; object-fit: contain; }
.main-nav { display: flex; align-items: center; gap: 30px; }
.main-nav a { position: relative; padding: 9px 0; color: rgba(239,246,255,.72); font-size: 12px; font-weight: 600; transition: color .18s ease; }
.main-nav a:hover, .main-nav a.active { color: #fff; }
.main-nav a.active::after { position: absolute; right: 0; bottom: 0; left: 0; height: 2px; border-radius: 999px; background: #93c5fd; content: ""; }
.hero-shell { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; min-height: calc(100vh - 150px); padding: 4vh 6vw 13vh; text-align: center; }
.hero-content { max-width: 780px; animation: rise-in .7s ease-out both; }
.eyebrow { margin: 0 0 24px; color: #a5f3fc; font-size: 11px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
.landing-page h1 { margin: 0; color: #fff; font-size: clamp(3.25rem, 8vw, 7.5rem); font-weight: 750; letter-spacing: -.07em; line-height: .9; }
.landing-page h1 span { color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,.88); }
.subtitle { margin: 28px 0 32px; color: rgba(239,246,255,.78); font-size: clamp(1rem,2vw,1.24rem); }
.primary-button { display: inline-flex; align-items: center; gap: 30px; padding: 14px 18px 14px 22px; border: 1px solid rgba(255,255,255,.45); border-radius: var(--radius-sm); background: #fff; color: var(--navy-deep); font-size: 12px; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; box-shadow: 0 10px 28px rgba(7,20,56,.2); transition: transform .18s ease, box-shadow .18s ease, background .18s ease; }
.primary-button:hover { transform: translateY(-2px); background: #dbeafe; box-shadow: 0 16px 32px rgba(7,20,56,.3); }
.button-arrow { color: var(--primary); font-size: 20px; line-height: 10px; }
.supporting-line { display: flex; align-items: center; justify-content: center; gap: 10px; margin: 26px 0 0; color: rgba(239,246,255,.62); font-size: 11px; letter-spacing: .04em; }
.supporting-line i { width: 4px; height: 4px; border-radius: 99px; background: #99f6e4; }
.hero-footer { position: absolute; right: 6vw; bottom: 28px; left: 6vw; z-index: 1; display: flex; justify-content: space-between; color: rgba(239,246,255,.48); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; }
@keyframes rise-in { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
.dashboard-page { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 24px; background: var(--navy-deep); }
.dashboard-card { width: 100%; max-width: 560px; padding: 48px; border-radius: var(--radius-lg); background: #e0f2fe; box-shadow: var(--shadow-md); }
.dashboard-card h1 { margin: 20px 0; color: var(--navy-deep); font-size: clamp(2.75rem,8vw,4.8rem); letter-spacing: -.06em; line-height: .9; }
.dashboard-message { margin-bottom: 32px; color: var(--ink-muted); }
.secondary-button { display: inline-block; padding: 12px 16px; border: 1px solid var(--navy); border-radius: var(--radius-sm); color: var(--navy); font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }

/* Application shell */
.app-page { --app-ink: var(--ink-strong); --app-muted: var(--ink-muted); --app-line: var(--line); --app-paper: var(--canvas); min-height: 100vh; background: var(--app-paper); color: var(--app-ink); }
.app-shell { --sidebar-width: 252px; display: flex; min-height: 100vh; }
.app-sidebar { position: sticky; top: 0; display: flex; flex: 0 0 var(--sidebar-width); flex-direction: column; width: var(--sidebar-width); min-width: var(--sidebar-width); height: 100vh; padding: 24px 16px 18px; overflow-y: auto; color: #d9e3f8; background: linear-gradient(180deg,#172554 0%,#101c40 100%); box-shadow: 3px 0 18px rgba(15,23,42,.07); transition: width .24s ease, min-width .24s ease, flex-basis .24s ease, padding .24s ease; }
.sidebar-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.app-brand { display: flex; align-items: center; min-width: 0; gap: 10px; color: #f8fbff; font-size: 11px; font-weight: 750; letter-spacing: .1em; line-height: 1.2; }
.app-brand b { color: #93c5fd; font-weight: 650; }
.app-brand-mark { display: inline-flex; flex: 0 0 38px; align-items: center; justify-content: center; width: 38px; height: 38px; border: 1px solid #7db4ff; border-radius: 10px; color: #dbeafe; background: rgba(59,130,246,.12); font-size: 13px; font-weight: 800; letter-spacing: -.05em; }
.app-brand-copy, .nav-label, .back-home-label { display: inline-block; max-width: 155px; overflow: hidden; white-space: nowrap; transition: max-width .2s ease, opacity .16s ease; }
.sidebar-toggle { display: inline-flex; flex: 0 0 30px; align-items: center; justify-content: center; width: 30px; height: 30px; padding: 0; border: 1px solid rgba(191,219,254,.3); border-radius: 7px; color: #bfdbfe; background: rgba(255,255,255,.04); font-size: 17px; line-height: 1; transition: border-color .18s ease, background .18s ease, color .18s ease; }
.sidebar-toggle:hover, .sidebar-toggle:focus-visible { border-color: #bfdbfe; color: #fff; background: rgba(59,130,246,.3); outline: 0; }
.group-switcher { padding: 0 8px 17px; border-bottom: 1px solid rgba(191,219,254,.15); }
.sidebar-label { margin: 38px 8px 11px; overflow: hidden; color: #8fa5cf; font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; transition: max-height .2s ease, margin .2s ease, opacity .16s ease; }
.group-switcher .sidebar-label { display: block; margin: 0 0 8px; }
.group-switcher select { width: 100%; max-width: 100%; min-height: 36px; padding: 7px 9px; border: 1px solid rgba(191,219,254,.25); border-radius: 6px; color: #eff6ff; background: rgba(255,255,255,.09); font-size: 12px; }
.group-switcher select:focus { border-color: #93c5fd; outline: var(--focus-ring); }
.group-switcher option { color: var(--ink-strong); background: #fff; }
.group-switcher a, .group-delete-button { display: inline-block; margin-top: 9px; padding: 0; border: 0; color: #a7f3d0; background: transparent; font-size: 11px; }
.group-delete-button { color: #fecaca; }
.group-switcher a:hover, .group-delete-button:hover { color: #fff; text-decoration: underline; }
.side-nav { display: grid; gap: 4px; }
.side-nav a { display: flex; align-items: center; gap: 12px; min-height: 40px; padding: 9px 10px; border: 1px solid transparent; border-radius: 8px; color: #c0cde8; font-size: 12px; font-weight: 600; transition: color .18s ease, border-color .18s ease, background .18s ease, transform .18s ease; }
.side-nav .nav-number { flex: 0 0 18px; width: 18px; color: #7890bc; font-size: 9px; font-variant-numeric: tabular-nums; }
.side-nav a:hover { color: #fff; background: rgba(96,165,250,.13); transform: translateX(2px); }
.side-nav a:hover .nav-number { color: #bfdbfe; }
.side-nav a.active, .side-nav a[aria-current="page"] { border-color: rgba(147,197,253,.25); color: #fff; background: rgba(59,130,246,.23); box-shadow: inset 3px 0 0 #93c5fd; }
.side-nav a.active .nav-number, .side-nav a[aria-current="page"] .nav-number { color: #bfdbfe; }
.back-home { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; padding: 18px 9px 0; border-top: 1px solid rgba(191,219,254,.15); color: #aebedb; font-size: 11px; transition: color .18s ease; }
.back-home:hover { color: #fff; }
.back-home b { flex: 0 0 auto; font-size: 17px; font-weight: 400; }
.app-main { flex: 1; width: calc(100% - var(--sidebar-width)); min-width: 0; max-width: calc(100vw - var(--sidebar-width)); padding: clamp(28px,4vw,52px) clamp(20px,4vw,64px) 54px; transition: max-width .24s ease, padding .24s ease; }
.app-page.sidebar-collapsed .app-shell { --sidebar-width: 74px; }
.app-page.sidebar-collapsed .app-sidebar { padding-right: 10px; padding-left: 10px; }
.app-page.sidebar-collapsed .sidebar-header { display: grid; justify-items: center; gap: 10px; }
.app-page.sidebar-collapsed .app-brand-copy, .app-page.sidebar-collapsed .nav-label, .app-page.sidebar-collapsed .back-home-label { max-width: 0; opacity: 0; pointer-events: none; }
.app-page.sidebar-collapsed .sidebar-label { max-height: 0; margin: 25px 0 0; opacity: 0; }
.app-page.sidebar-collapsed .side-nav a { justify-content: center; gap: 0; padding-right: 0; padding-left: 0; }
.app-page.sidebar-collapsed .back-home { justify-content: center; padding-right: 0; padding-left: 0; }

/* Structure and controls */
.app-header, .summary-section, .monthly-panel, .table-panel, .form-panel, .sheet-panel, .reconciliation-panel, .currency-count-panel, .report-filter, .dashboard-section, .product-setup-view, .setup-messages, .form-error { max-width: 1440px; margin-right: auto; margin-left: auto; }
.app-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 30px; }
.app-header h1 { margin: 7px 0 0; color: var(--ink-strong); font-size: clamp(2rem,4vw,3.25rem); font-weight: 750; letter-spacing: -.055em; line-height: 1.02; }
.page-kicker { margin: 0; color: var(--primary); font-size: 10px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
.setup-subtitle, .dashboard-group-name { margin: 9px 0 0; color: var(--app-muted); font-size: 13px; }
.dashboard-group-name { font-weight: 600; }
.date-chip, .section-heading > span { color: var(--app-muted); font-size: 12px; line-height: 1.4; }
.date-chip { display: inline-flex; align-items: center; min-height: 38px; padding: 0 11px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); font-weight: 600; box-shadow: var(--shadow-sm); }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px; }
.section-heading > div { min-width: 0; }
.section-heading h2, .setup-card-heading h2, .catalog-toolbar h2 { margin: 0; color: var(--ink-strong); font-size: 19px; font-weight: 725; letter-spacing: -.025em; line-height: 1.25; }
.section-heading .page-kicker { margin-bottom: 4px; }
.dark-button, .outline-button { display: inline-flex; align-items: center; justify-content: center; min-height: 38px; padding: 9px 13px; border: 1px solid transparent; border-radius: 7px; font-size: 11px; font-weight: 750; letter-spacing: .045em; line-height: 1.2; text-align: center; text-transform: uppercase; transition: transform .16s ease, border-color .16s ease, background .16s ease, box-shadow .16s ease, color .16s ease; }
.dark-button { border-color: var(--primary); color: #fff; background: var(--primary); box-shadow: 0 1px 2px rgba(29,78,216,.2); }
.dark-button:hover { border-color: var(--primary-hover); background: var(--primary-hover); box-shadow: 0 5px 12px rgba(29,78,216,.2); transform: translateY(-1px); }
.outline-button { border-color: var(--line-strong); color: #334155; background: var(--surface); box-shadow: var(--shadow-sm); }
.outline-button:hover { border-color: #93a9c7; color: var(--navy); background: #f8fbff; transform: translateY(-1px); }
.dark-button:focus-visible, .outline-button:focus-visible { outline: none; box-shadow: var(--focus-ring); }
.dark-button:disabled, .outline-button:disabled { transform: none; box-shadow: none; }
.is-loading, [aria-busy="true"] { pointer-events: none; cursor: progress; opacity: .72; }
.is-loading::after, [aria-busy="true"]::after { width: 11px; height: 11px; margin-left: 8px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; content: ""; animation: control-spin .65s linear infinite; }
@keyframes control-spin { to { transform: rotate(360deg); } }
input, select, textarea { width: 100%; min-width: 0; min-height: 40px; padding: 9px 11px; border: 1px solid var(--line-strong); border-radius: 7px; color: var(--ink-strong); background: var(--surface); font-size: 13px; line-height: 1.3; box-shadow: 0 1px 1px rgba(15,23,42,.015); transition: border-color .16s ease, box-shadow .16s ease, background .16s ease; }
input:hover, select:hover, textarea:hover { border-color: #a8b8cf; }
input:focus, select:focus, textarea:focus { border-color: #3b82f6; outline: none; box-shadow: var(--focus-ring); }
input:user-invalid, select:user-invalid, textarea:user-invalid { border-color: #e59a94; }
input::placeholder, textarea::placeholder { color: #98a2b3; opacity: 1; }
input[readonly] { color: #475467; background: var(--surface-muted); cursor: default; }
textarea { min-height: 92px; resize: vertical; }
label { color: var(--app-muted); font-size: 11px; font-weight: 700; }
.meta-grid label, .report-filter label, .recon-grid label, .product-form label, .catalog-filters label { display: grid; gap: 7px; }

/* Panels, tables, feedback */
.form-panel, .table-panel, .sheet-panel, .reconciliation-panel, .currency-count-panel, .setup-card, .chart-panel, .panel-block { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow-sm); }
.form-panel, .table-panel, .reconciliation-panel, .currency-count-panel, .setup-card, .chart-panel, .panel-block { padding: 22px; }
.table-panel, .form-panel, .sheet-panel, .reconciliation-panel, .currency-count-panel, .setup-card { margin-bottom: 24px; }
.sheet-panel { overflow: hidden; padding: 0; }
.sheet-heading { padding: 20px 22px 15px; margin: 0; }
.table-scroll, .sheet-scroll, .currency-count-layout { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-color: #b8c5d6 transparent; }
.data-table { width: 100%; min-width: 680px; border-collapse: separate; border-spacing: 0; }
.data-table th { padding: 11px 12px; border-bottom: 1px solid var(--line-strong); color: #64748b; background: #f8fafc; font-size: 10px; font-weight: 800; letter-spacing: .07em; line-height: 1.25; text-align: left; text-transform: uppercase; white-space: nowrap; }
.data-table td { padding: 12px; border-bottom: 1px solid #edf1f5; color: #475467; font-size: 12px; vertical-align: middle; }
.data-table tbody tr { transition: background .14s ease; }
.data-table tbody tr:hover { background: #f8fbff; }
.data-table tbody tr:last-child td { border-bottom: 0; }
.data-table td strong, .data-table td a strong { color: var(--ink-strong); font-weight: 700; }
.data-table td a:not(.outline-button) { color: #1d4ed8; }
.data-table td a:not(.outline-button):hover { text-decoration: underline; }
.data-table tfoot th { border-top: 1px solid var(--line-strong); border-bottom: 0; color: #334155; background: #edf4ff; }
.empty-state { padding: 28px !important; color: var(--app-muted) !important; text-align: center; }
.status-pill { display: inline-flex; align-items: center; min-height: 22px; padding: 3px 8px; border: 1px solid #b9e7ca; border-radius: 999px; color: #167341; background: var(--success-soft); font-size: 10px; font-weight: 800; letter-spacing: .045em; line-height: 1.1; }
.status-pill.pending { border-color: #f2d395; color: var(--warning); background: var(--warning-soft); }
.status-pill.inactive { border-color: #d6dce6; color: #667085; background: #f2f4f7; }
.form-error, .setup-message { padding: 11px 13px; border: 1px solid #f6c7c4; border-left: 4px solid #d92d20; border-radius: 7px; color: #9e221a; background: var(--danger-soft); font-size: 12px; }
.form-error { margin-bottom: 18px; }
.form-error ul { margin: 8px 0; padding-left: 18px; }
.form-error p { margin: 8px 0; }
.stock-warning { max-width: 1440px; }
.setup-messages { margin-bottom: 18px; }
.setup-message { margin: 0 0 8px; border-color: #bce8ca; border-left-color: #16a34a; color: #166534; background: var(--success-soft); }
.setup-message.warning { border-color: #f5d49b; border-left-color: #d97706; color: #8a4c04; background: var(--warning-soft); }
.setup-message.error { border-color: #f6c7c4; border-left-color: #d92d20; color: #9e221a; background: var(--danger-soft); }
.field-error { display: block; margin-top: 4px; color: var(--danger); font-size: 11px; font-weight: 600; }
.report-filter { display: grid; grid-template-columns: repeat(4,minmax(130px,1fr)) auto; align-items: end; gap: 13px; margin-bottom: 22px; padding: 17px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow-sm); }
.report-filter .outline-button { min-width: 116px; }

/* Metrics and dashboard */
.metric-grid { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 14px; }
.metric-card { position: relative; min-width: 0; min-height: 122px; padding: 17px; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow-sm); transition: border-color .16s ease, box-shadow .16s ease, transform .16s ease; }
.metric-card:hover { border-color: #c5d4ea; box-shadow: var(--shadow-md); transform: translateY(-2px); }
.metric-card span, .metric-card small { display: block; color: var(--app-muted); font-size: 11px; line-height: 1.35; }
.metric-card strong { display: block; margin: 18px 0 6px; overflow-wrap: anywhere; color: var(--ink-strong); font-size: clamp(1.35rem,2.1vw,1.85rem); font-weight: 750; letter-spacing: -.035em; line-height: 1; font-variant-numeric: tabular-nums; }
.metric-card small { margin-top: 6px; font-size: 10px; }
.metric-primary { border-color: #bfdbfe; background: linear-gradient(135deg,#eff6ff,#f8fbff); }
.metric-primary::after { position: absolute; top: -28px; right: -28px; width: 88px; height: 88px; border-radius: 50%; background: rgba(96,165,250,.14); content: ""; }
.summary-metrics { margin-bottom: 22px; }
.dashboard-section { margin-bottom: 26px; }
.dashboard-header { margin-bottom: 32px; }
.dashboard-filter-wrap, .dashboard-period-filter, .setup-header-actions, .product-form-actions, .catalog-filters, .quick-action-grid, .category-manager-actions { display: flex; align-items: center; gap: 9px; }
.dashboard-filter-wrap { align-items: flex-end; }
.dashboard-period-filter select { min-width: 110px; }
.dashboard-today-grid { grid-template-columns: repeat(7,minmax(0,1fr)); }
.dashboard-month-grid { grid-template-columns: repeat(8,minmax(0,1fr)); }
.dashboard-today-grid .metric-card strong, .dashboard-month-grid .metric-card strong { font-size: clamp(1rem,1.25vw,1.25rem); letter-spacing: -.06em; }
.dashboard-chart-grid, .dashboard-stock-grid, .dashboard-content-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20px; }
.bar-chart { display: flex; align-items: flex-end; gap: 4px; height: 230px; padding-top: 18px; overflow-x: auto; }
.bar-column { display: flex; flex: 1 0 19px; flex-direction: column; align-items: center; justify-content: flex-end; min-width: 19px; height: 100%; }
.bar-value { min-height: 15px; color: var(--app-muted); font-size: 9px; }
.bar-track { display: flex; align-items: flex-end; justify-content: center; width: 100%; height: 176px; border-radius: 3px 3px 0 0; background: #eef2f8; }
.bar-fill { width: 72%; min-height: 0; border-radius: 3px 3px 0 0; transition: height .2s ease; }
.sales-fill { background: linear-gradient(180deg,#60a5fa,#2563eb); }
.order-fill { background: linear-gradient(180deg,#fbbf24,#d97706); }
.bar-label { margin-top: 7px; color: var(--app-muted); font-size: 9px; }
.stock-overview { min-height: 100%; }
.stock-stat-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 10px; }
.stock-stat-grid div { padding: 14px 10px; border: 1px solid #e7edf5; border-radius: 8px; background: #f8fafc; }
.stock-stat-grid strong, .stock-stat-grid span { display: block; }
.stock-stat-grid strong { color: var(--ink-strong); font-size: 24px; font-weight: 750; letter-spacing: -.03em; line-height: 1.1; }
.stock-stat-grid span { margin-top: 5px; color: var(--app-muted); font-size: 10px; }
.stock-lists { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
.stock-lists h3 { margin: 0 0 10px; color: var(--ink-strong); font-size: 14px; }
.stock-list-row { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); color: #475467; font-size: 12px; }
.stock-list-row strong { color: var(--danger); font-weight: 700; text-align: right; }
.ranked-list { display: grid; }
.ranked-row { display: flex; align-items: center; gap: 11px; padding: 12px 0; border-bottom: 1px solid var(--line); }
.ranked-row:last-child { border-bottom: 0; }
.rank-number { display: inline-flex; flex: 0 0 26px; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; color: #1d4ed8; background: #e8efff; font-size: 11px; font-weight: 750; }
.rank-name { flex: 1; min-width: 0; color: var(--ink); font-size: 12px; }
.rank-name small { display: block; margin-top: 2px; overflow: hidden; color: var(--app-muted); font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
.ranked-row strong { color: var(--ink-strong); font-size: 12px; }
.quick-actions { padding-bottom: 8px; }
.quick-action-grid { flex-wrap: wrap; }
.monthly-panel { display: flex; align-items: center; justify-content: space-between; gap: 28px; margin-bottom: 26px; padding: 28px; border-radius: var(--radius-lg); color: #f8fafc; background: linear-gradient(135deg,#172554,#1d4ed8); box-shadow: var(--shadow-md); }
.monthly-panel h2 { margin: 8px 0; font-size: 24px; font-weight: 700; }
.panel-copy { max-width: 310px; margin: 0; color: #c9d9fb; font-size: 12px; }
.monthly-metrics { display: grid; grid-template-columns: repeat(4,minmax(80px,1fr)); gap: 24px; }
.monthly-metrics span, .monthly-metrics b { display: block; }
.monthly-metrics span { margin-bottom: 8px; color: #bfdbfe; font-size: 10px; }
.monthly-metrics b { color: #fff; font-size: 20px; font-weight: 700; }

/* Product setup */
.product-setup-view .app-header { margin-bottom: 26px; }
.setup-card-heading, .catalog-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-bottom: 20px; }
.setup-card-heading h2, .catalog-toolbar h2 { margin-top: 5px; font-size: 20px; }
.setup-card-heading > span, .catalog-toolbar > span { color: var(--app-muted); font-size: 11px; text-align: right; }
.product-form { display: grid; gap: 21px; }
.product-form fieldset { min-width: 0; margin: 0; padding: 19px 0 0; border: 0; border-top: 1px solid var(--line); }
.product-form legend { padding: 0 10px 0 0; color: #475467; font-size: 10px; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
.product-form-grid { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 14px; }
.product-info-grid { grid-template-columns: 1fr 2fr 1fr; }
.product-other-grid { grid-template-columns: minmax(0,220px); }
.product-form-actions { padding-top: 20px; border-top: 1px solid var(--line); }
.category-select-row { display: flex; gap: 8px; }
.category-select-row select { min-width: 0; }
.category-select-row .outline-button { flex: 0 0 auto; min-height: 40px; padding-right: 10px; padding-left: 10px; font-size: 10px; }
.catalog-toolbar { align-items: flex-end; }
.catalog-filters { flex-wrap: wrap; }
.catalog-filters label { min-width: 145px; }
.catalog-filters .search-field { min-width: 230px; }
.catalog-filters label span { color: var(--app-muted); font-size: 10px; }
.product-table { min-width: 920px; }
.product-actions { display: flex; align-items: center; gap: 10px; white-space: nowrap; }
.product-actions form { margin: 0; }
.product-actions a, .product-actions button { padding: 0; border: 0; color: #1d4ed8; background: transparent; font-size: 11px; font-weight: 700; }
.product-actions a:hover, .product-actions button:hover { color: var(--primary-hover); text-decoration: underline; }
.product-actions button { color: var(--danger); }
.product-pagination { display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 18px; padding-top: 17px; border-top: 1px solid var(--line); }
.product-pagination a { color: var(--primary); font-size: 12px; font-weight: 700; }
.product-pagination a:hover { text-decoration: underline; }
.product-pagination span { color: var(--app-muted); font-size: 11px; }

/* Daily sales, invoices, and cash */
.compact-form, .meta-grid, .recon-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 13px; }
.compact-form .dark-button { align-self: stretch; }
.transaction-meta .meta-grid label { min-width: 0; }
.credit-dealer-panel { margin-bottom: 18px; }
.credit-dealer-panel .meta-grid { align-items: end; }
.credit-dealer-panel .setup-subtitle { max-width: 500px; margin: 0; padding-bottom: 2px; }
.route-suggestion { margin: 14px 0 0; padding: 10px 12px; border: 1px solid #bfdbfe; border-radius: 7px; color: #1e3a8a; background: #eff6ff; font-size: 12px; }
.selected-unit-note { max-width: 1440px; margin: -23px auto 27px; color: var(--app-muted); font-size: 11px; }
.selected-unit-note strong { color: var(--ink-strong); }
.sales-sheet { width: 100%; min-width: 1440px; border-collapse: separate; border-spacing: 0; font-size: 11px; }
.invoice-edit-sheet { min-width: 760px; }
.sales-sheet th { padding: 9px 7px; border-right: 1px solid #c7d5e8; border-bottom: 1px solid #c7d5e8; color: #28405f; background: #e8f0fb; font-size: 10px; font-weight: 800; line-height: 1.18; text-align: center; white-space: nowrap; }
.sales-sheet td { min-width: 65px; padding: 4px; border-right: 1px solid #e1e8f0; border-bottom: 1px solid #e1e8f0; color: #475467; text-align: center; white-space: nowrap; }
.sales-sheet .sticky-product { position: sticky; left: 0; min-width: 205px; text-align: left; z-index: 2; }
.sales-sheet thead .sticky-product { z-index: 4; background: #dce9fa; }
.sales-sheet tbody .sticky-product { background: #fff; box-shadow: 2px 0 3px rgba(15,23,42,.04); }
.sales-sheet select, .sales-sheet input { min-width: 55px; min-height: 34px; padding: 6px 5px; border-color: transparent; border-radius: 5px; background: #fff; font-size: 11px; }
.sales-sheet select:hover, .sales-sheet input:hover { border-color: #b7c8e0; }
.sales-sheet select:focus, .sales-sheet input:focus { border-color: #3b82f6; box-shadow: 0 0 0 2px rgba(59,130,246,.16); }
.sales-sheet .calc { color: #334155; background: #f5f8fc; }
.sales-sheet .row-invalid { background: #fff5f4; }
.sales-sheet .row-invalid .returned { border-color: #ef8f88; }
.sales-sheet .stock-short { background: #fffbeb; }
.sales-sheet .stock-short .order { border-color: #e4a11b; }
.sales-sheet tfoot th { border-top: 1px solid #b7c8e0; border-bottom: 0; color: #243b53; background: #dce9fa; font-size: 11px; }
.remove-row, .remove-pending-row { min-width: 30px; min-height: 30px; padding: 0 6px; border: 0; border-radius: 5px; color: var(--danger); background: transparent; font-size: 20px; line-height: 1; }
.remove-pending-row { font-size: 11px; font-weight: 700; }
.remove-row:hover, .remove-pending-row:hover { background: var(--danger-soft); }
.remove-row:disabled { color: #aeb9c8; background: transparent; }
.currency-count-panel { max-width: 1440px; }
.currency-count-layout { max-width: 520px; }
.currency-count-table { width: 100%; min-width: 360px; border: 1px solid var(--line); border-radius: 8px; border-collapse: separate; border-spacing: 0; overflow: hidden; }
.currency-count-table th, .currency-count-table td { padding: 10px 12px; border-bottom: 1px solid var(--line); color: #475467; font-size: 12px; text-align: right; }
.currency-count-table th:first-child, .currency-count-table td:first-child { text-align: left; }
.currency-count-table thead th { color: #5d6b7f; background: #f8fafc; font-size: 10px; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
.currency-count-table input { min-width: 92px; min-height: 34px; padding: 6px 8px; text-align: right; }
.currency-count-table .currency-amount { color: #1e3a8a; background: #eff6ff; font-weight: 750; }
.currency-count-table tfoot th { border-bottom: 0; color: #243b53; background: #e8f0fb; font-size: 11px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
.reconciliation-panel { background: linear-gradient(135deg,#f7fbff,#f2f7ff); border-color: #d6e4f7; }
.recon-grid { grid-template-columns: repeat(5,minmax(0,1fr)) 1.25fr 1.25fr; }
.recon-output { align-self: end; display: grid; gap: 4px; min-height: 40px; padding: 1px 0 1px 12px; border-left: 3px solid #60a5fa; }
.recon-output span { color: var(--app-muted); font-size: 10px; font-weight: 700; }
.recon-output strong { color: var(--ink-strong); font-size: 18px; font-weight: 750; letter-spacing: -.02em; line-height: 1.2; }
.recon-output.warning { border-color: #f59e0b; }
.save-button { display: flex; margin: 0 auto 12px; }
.entry-total { display: flex; justify-content: space-between; gap: 16px; padding: 14px 22px; color: var(--app-muted); font-size: 11px; }

/* Godown, categories, and management details */
.godown-category .section-heading > div { display: grid; gap: 4px; }
.godown-category .section-heading .page-kicker { margin: 0; }
.godown-table { min-width: 760px; }
.godown-table .outline-button, .godown-history-select .outline-button { min-height: 32px; padding: 7px 9px; }
.godown-form-panel { max-width: 980px; }
.godown-receipt-form { display: grid; gap: 19px; }
.godown-detail-grid { grid-template-columns: 1fr 2fr; }
.godown-notes textarea { min-height: 86px; }
.meta-grid label small, .bulk-stock-table small { display: block; margin-top: 5px; color: var(--app-muted); font-size: 10px; line-height: 1.35; }
.godown-history-table { min-width: 980px; }
.bulk-stock-table { min-width: 760px; }
.bulk-stock-table input, .bulk-stock-table select { min-width: 100px; min-height: 36px; padding: 7px 8px; font-size: 12px; }
.bulk-stock-total { color: #166534; font-weight: 750; white-space: nowrap; }
.bulk-stock-table .row-invalid { background: #fff5f4; }
.category-manager-card { max-width: 980px; }
.category-create-form, .category-rename-form, .category-manager-actions { display: flex; align-items: center; gap: 8px; }
.category-create-form { min-width: min(100%,360px); }
.category-create-form input, .category-rename-form input { min-width: 0; }
.category-manager-list { display: grid; gap: 0; }
.category-manager-row { display: grid; grid-template-columns: minmax(180px,1fr) auto auto; align-items: center; gap: 14px; padding: 13px 0; border-top: 1px solid var(--line); }
.category-rename-form input { width: 100%; }

/* Responsive */
@media (max-width: 1240px) {
    .dashboard-today-grid, .dashboard-month-grid, .metric-grid { grid-template-columns: repeat(4,minmax(0,1fr)); }
    .recon-grid { grid-template-columns: repeat(4,minmax(0,1fr)); }
}
@media (max-width: 980px) {
    .app-shell { --sidebar-width: 74px; }
    .app-page.sidebar-expanded .app-shell { --sidebar-width: 252px; }
    .app-sidebar { padding: 20px 10px; }
    .app-page:not(.sidebar-expanded) .sidebar-header { display: grid; justify-items: center; gap: 10px; }
    .app-page:not(.sidebar-expanded) .app-brand-copy, .app-page:not(.sidebar-expanded) .nav-label, .app-page:not(.sidebar-expanded) .back-home-label { max-width: 0; opacity: 0; pointer-events: none; }
    .app-page:not(.sidebar-expanded) .sidebar-label { max-height: 0; margin: 25px 0 0; opacity: 0; }
    .app-page:not(.sidebar-expanded) .side-nav a { justify-content: center; gap: 0; padding-right: 0; padding-left: 0; }
    .app-page:not(.sidebar-expanded) .back-home { justify-content: center; padding-right: 0; padding-left: 0; }
    .app-main { padding: 28px 20px 42px; }
    .app-header, .dashboard-header { align-items: flex-start; display: grid; }
    .setup-header-actions, .dashboard-filter-wrap { flex-wrap: wrap; }
    .dashboard-filter-wrap { align-items: flex-start; }
    .dashboard-chart-grid, .dashboard-stock-grid, .dashboard-content-grid { grid-template-columns: 1fr; }
    .metric-grid, .dashboard-today-grid, .dashboard-month-grid, .summary-metrics { grid-template-columns: repeat(3,minmax(0,1fr)); }
    .compact-form, .meta-grid, .recon-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .monthly-panel { align-items: flex-start; display: grid; }
    .product-form-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .product-info-grid { grid-template-columns: 1fr 1fr; }
    .product-info-grid label:nth-child(2) { grid-column: span 2; grid-row: 1; }
    .catalog-toolbar { align-items: flex-start; display: grid; }
    .catalog-filters { display: grid; grid-template-columns: 1fr 1fr; width: 100%; }
    .catalog-filters .search-field { grid-column: span 2; }
    .godown-detail-grid { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
    .topbar { padding: 22px 7vw; }
    .brand-mark img { max-width: 150px; max-height: 38px; }
    .main-nav { gap: 14px; }
    .main-nav a { font-size: 10px; }
    .hero-shell { min-height: calc(100vh - 125px); padding: 3vh 7vw 12vh; }
    .landing-page h1 { font-size: clamp(3rem,15vw,5.4rem); }
    .supporting-line { flex-wrap: wrap; line-height: 1.8; }
    .hero-footer { right: 7vw; bottom: 20px; left: 7vw; }
    .hero-footer span:last-child { display: none; }
    .dashboard-card { padding: 34px 25px; }
    .app-shell { --sidebar-width: 0px; display: block; }
    .app-sidebar { position: fixed; z-index: 20; left: 0; width: 0; min-width: 0; padding: 0; overflow: hidden; opacity: 0; box-shadow: none; pointer-events: none; }
    .app-page.sidebar-expanded .app-sidebar { width: min(280px,calc(100vw - 42px)); min-width: min(280px,calc(100vw - 42px)); padding: 20px 14px; opacity: 1; box-shadow: 8px 0 30px rgba(15,23,42,.27); pointer-events: auto; }
    .app-page.sidebar-expanded .app-brand-copy, .app-page.sidebar-expanded .nav-label, .app-page.sidebar-expanded .back-home-label { max-width: 155px; opacity: 1; pointer-events: auto; }
    .app-page.sidebar-expanded .sidebar-label { max-height: 30px; margin: 32px 8px 11px; opacity: 1; }
    .app-page.sidebar-expanded .side-nav a { justify-content: flex-start; gap: 12px; padding-right: 10px; padding-left: 10px; }
    .app-page.sidebar-expanded .back-home { justify-content: space-between; padding-right: 9px; padding-left: 9px; }
    .app-main { width: 100%; max-width: 100vw; padding: 22px 14px 36px; }
    .app-header { gap: 17px; margin-bottom: 22px; }
    .app-header h1 { font-size: clamp(1.85rem,10vw,2.5rem); }
    .section-heading { align-items: flex-start; flex-direction: column; gap: 6px; }
    .section-heading > span { text-align: left; }
    .form-panel, .table-panel, .reconciliation-panel, .currency-count-panel, .setup-card, .chart-panel, .panel-block { padding: 16px; }
    .sheet-heading { padding: 16px 16px 13px; }
    .metric-grid, .dashboard-today-grid, .dashboard-month-grid, .summary-metrics, .stock-stat-grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; }
    .metric-card { min-height: 105px; padding: 14px; }
    .metric-card strong { margin-top: 14px; font-size: 1.4rem; }
    .dashboard-period-filter { display: grid; grid-template-columns: 1fr 1fr auto; width: 100%; }
    .dashboard-period-filter select { min-width: 0; }
    .dashboard-period-filter .dark-button { padding-right: 10px; padding-left: 10px; }
    .report-filter { grid-template-columns: 1fr; padding: 14px; }
    .report-filter .outline-button { width: 100%; }
    .compact-form, .meta-grid, .recon-grid, .product-form-grid, .product-info-grid, .catalog-filters { grid-template-columns: 1fr; }
    .product-info-grid label:nth-child(2), .catalog-filters .search-field { grid-column: auto; }
    .product-other-grid { grid-template-columns: 1fr; }
    .setup-header-actions, .product-form-actions { display: grid; align-items: stretch; grid-template-columns: 1fr; width: 100%; }
    .setup-header-actions > *, .product-form-actions > * { width: 100%; }
    .category-select-row { align-items: stretch; flex-direction: column; }
    .category-select-row .outline-button { width: 100%; }
    .catalog-filters { gap: 11px; }
    .catalog-filters label, .catalog-filters .search-field { width: 100%; min-width: 0; }
    .catalog-toolbar, .setup-card-heading { gap: 12px; }
    .setup-card-heading > span, .catalog-toolbar > span { text-align: left; }
    .monthly-metrics { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 17px; }
    .stock-lists { grid-template-columns: 1fr; gap: 18px; }
    .dashboard-filter-wrap, .quick-action-grid { width: 100%; }
    .dashboard-filter-wrap .date-chip { width: fit-content; }
    .quick-action-grid .dark-button, .quick-action-grid .outline-button { flex: 1 1 100%; }
    .category-create-form, .category-rename-form, .category-manager-actions { align-items: stretch; flex-direction: column; width: 100%; }
    .category-manager-row { grid-template-columns: 1fr; gap: 10px; }
    .category-manager-actions { flex-direction: row; flex-wrap: wrap; }
    .category-manager-actions form { flex: 1 1 auto; }
    .category-manager-actions .outline-button { width: 100%; }
    .entry-total { flex-direction: column; gap: 4px; padding: 13px 16px; }
}
@media print {
    .app-sidebar, .sidebar-toggle, .setup-header-actions, .product-form-actions, .quick-actions, .report-filter, .dark-button, .outline-button { display: none !important; }
    .app-shell, .app-main { display: block; width: 100%; max-width: none; padding: 0; }
    .app-page, body { background: #fff; }
    .form-panel, .table-panel, .sheet-panel, .reconciliation-panel, .currency-count-panel, .setup-card, .chart-panel, .panel-block { break-inside: avoid; box-shadow: none; }
}
